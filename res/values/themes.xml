<resources>
    <!-- The page is Compose (ChargingTheme); this only sets the window, like LunarisDolby -->
    <style name="Theme.BypassCharging" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.BypassCharging</item>
    </style>

    <style name="Animation.BypassCharging" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/motion_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/motion_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/motion_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/motion_pop_exit</item>
    </style>
</resources>
